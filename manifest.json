{
  "manifest_version": 3,
  "name": "SLT Data Meter Pro",
  "version": "1.0.0",
  "description": "Monitor your SLT broadband data usage",
  "permissions": [
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://myslt.slt.lk/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
